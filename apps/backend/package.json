{
  "name": "@scentiq/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ScentIQ backend: Fastify modular monolith (REST + SEO shell).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -b tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/cli/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env --import tsx src/db/cli/reset.ts",
    "seed:reference": "node --env-file-if-exists=.env --import tsx src/db/cli/seed.ts reference",
    "seed:dev": "node --env-file-if-exists=.env --import tsx src/db/cli/seed.ts dev",
    "db:assert-no-sample-data": "node --env-file-if-exists=.env --import tsx src/db/cli/assert-no-sample-data.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "^10.1.5",
    "@scentiq/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
