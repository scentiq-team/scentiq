# Copy to .env (never commit .env). Every variable is validated at startup (src/config/env.ts).

# development | test | staging | production
APP_ENV=development

# Interface and port the HTTP server binds to.
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Set to true only when the server is reachable exclusively through a trusted reverse proxy
# (Caddy/Cloudflare). It makes the client IP come from X-Forwarded-For (needed for rate limits).
TRUST_PROXY=false

# Public origin of the site, used for canonical URLs, hreflang and Open Graph.
# Required (and must be https) in staging and production.
# SITE_ORIGIN=https://example.com

# Folder with the built frontend (apps/frontend/dist). Relative paths are resolved from the
# directory the server starts in (apps/backend when you use the pnpm scripts).
FRONTEND_DIST_DIR=../frontend/dist

# --- Database (PostgreSQL 18 or newer; see docs/database.md) ---
# The values below match the development roles in docker/postgres/01-dev-roles.sql and the
# docker-compose.yml database. They contain the word "devonly" on purpose: staging and production
# refuse any URL with such a password.

# What the running server uses: the least-privilege role scentiq_app (reads and writes rows, cannot
# change the schema). Optional in development and test (without it the server runs with no
# database and /readyz only checks the frontend). Required in staging and production.
DATABASE_URL=postgres://scentiq_app:devonly_app@127.0.0.1:5432/scentiq_dev

# The owner role. Used only by `pnpm db:migrate` and `pnpm db:reset`, never by the server. In
# production keep it out of the server's environment and use it only in the deployment step.
MIGRATION_DATABASE_URL=postgres://scentiq_owner:devonly_owner@127.0.0.1:5432/scentiq_dev

# Maximum connections the server keeps open (1 to 50).
DATABASE_POOL_MAX=10
