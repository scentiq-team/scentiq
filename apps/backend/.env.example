# Copy to .env (never commit .env). Every variable is validated at startup (src/config/env.ts).

# development | test | staging | production
APP_ENV=development

# Interface and port the HTTP server binds to.
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Set to true only when the server is reachable exclusively through a trusted reverse proxy
# (Caddy/Cloudflare). It makes the client IP come from X-Forwarded-For (needed for rate limits).
TRUST_PROXY=false

# Public origin of the site, used for canonical URLs, hreflang and Open Graph.
# Required (and must be https) in staging and production.
# SITE_ORIGIN=https://example.com

# Folder with the built frontend (apps/frontend/dist). Relative paths are resolved from the
# directory the server starts in (apps/backend when you use the pnpm scripts).
FRONTEND_DIST_DIR=../frontend/dist
