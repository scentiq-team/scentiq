{
  "name": "@scentiq/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contracts and pure helpers shared by the frontend and the backend (no database types).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
