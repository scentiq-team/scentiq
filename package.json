{
  "name": "scentiq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ScentIQ — luxury perfume store (Arabic-first, RTL, Iraq-first).",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @scentiq/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @scentiq/backend start",
    "typecheck": "tsc -b && pnpm -r typecheck:tests",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @scentiq/frontend test:e2e",
    "clean": "node scripts/clean.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2"
  }
}
